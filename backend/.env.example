DATABASE_URL="postgresql://streak:streak@localhost:5433/streakarena"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Google sign-in is optional: leave these blank and the app hides the button and
# keeps password login. Create the client at console.cloud.google.com under
# Google Auth Platform -> Clients -> Web application, scopes openid/email/profile.
#
# GOOGLE_REDIRECT_URI must match the console entry exactly — scheme, case and
# trailing slash all count. Google requires https and rejects raw IP addresses;
# localhost is the one exemption, which is why dev works on :4000.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# Where the OAuth callback sends the browser once it's done. Leave blank in
# production, where Express serves the bundle on its own origin; in dev the React
# app is on another port, so point it there.
APP_ORIGIN=""

# Background sync of every linked platform, in minutes. 0 turns it off. Users synced
# more recently than this (by hand or by the last run) are skipped.
SYNC_INTERVAL_MINUTES=180

# Email (password reset, verification). Without RESEND_API_KEY mail is printed to the
# log instead and the UI hides "Forgot password?". APP_URL is the public base URL the
# links point at, e.g. https://streakarena.app.
RESEND_API_KEY=""
MAIL_FROM="StreakArena <hello@streakarena.app>"
APP_URL="http://localhost:5173"

# Set when a proxy sits in front (Caddy, ALB, CloudFront) so rate limits see the real
# client IP: a hop count such as 1.
TRUST_PROXY=""

# Push notifications (reminders). Generate a pair once with
#   npx web-push generate-vapid-keys
# and never rotate casually: every existing browser subscription is tied to it.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@streakarena.app"
# The reminder worker (pg-boss, in the "pgboss" schema). false turns it off.
REMINDERS_ENABLED=true
