generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  username String @unique

  // Null for an account that has only ever signed in with Google. A password and a
  // Google identity are independent: an account can have either, or both.
  passwordHash String?

  // Google's `sub` claim, not the email — `sub` is stable, and a Google address can
  // be changed by its owner. googleEmail is kept only to show which account is linked.
  googleId    String? @unique
  googleEmail String?

  timezone  String   @default("UTC")
  createdAt DateTime @default(now())

  // The public face of an account. All optional: an account works with none of it.
  displayName String?
  bio         String?
  location    String?
  avatarUrl   String?

  tasks             Task[]
  platformAccounts  PlatformAccount[]
  platformActivity  PlatformActivity[]
  groupsCreated     Group[]           @relation("GroupsCreated")
  challengesCreated GroupTask[]       @relation("ChallengesCreated")
  memberships       GroupMember[]
  messages          GroupMessage[]
}

// A group of friends competing on the same daily challenges.
model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  inviteCode  String   @unique
  createdById String
  createdAt   DateTime @default(now())

  // Private is the default and the safe one: a group is reachable only by its
  // invite code until its owner deliberately lists it. Public groups appear in
  // Discover and can be joined without a code.
  visibility String @default("private")

  createdBy User           @relation("GroupsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  members   GroupMember[]
  tasks     GroupTask[]
  messages  GroupMessage[]
}

// Group chat. Messages belong to the group, not to a membership, so leaving doesn't
// blank out half a conversation for everyone still reading it.
model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  body      String
  createdAt DateTime @default(now())

  // At most one attachment per message. The bytes live on disk in a mounted volume;
  // only the metadata and the stored filename are in the database, and the file is
  // served through a route that checks membership — never as static content.
  fileName String?
  fileType String?
  fileSize Int?
  filePath String?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// A shared challenge. Each member tracks it through their own Task, so streaks,
// tiles and platform sync all keep working exactly as they do for a solo task —
// the group only decides what everyone is racing on.
model GroupTask {
  id        String   @id @default(cuid())
  groupId   String
  title     String
  platform  String?
  createdAt DateTime @default(now())

  // Who put this challenge on everyone's board. Nulled rather than cascaded if
  // they leave, so the challenge survives the person who suggested it.
  createdById String?

  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ChallengesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([groupId])
}

// A handle on an external site — the link between a task and where you actually do it.
// No tokens, no scraping (yet): this is what makes a task one click from your profile.
model PlatformAccount {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  handle    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sync bookkeeping: what the last check found, so the UI can say when it ran
  // and why it failed without re-running it.
  lastSyncedAt  DateTime?
  lastSyncError String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  platform    String?
  createdAt   DateTime @default(now())

  // "daily" is a recurring habit and the only kind a streak is made of. "once" is a
  // single job on a single day: no streak, and kept out of the heatmap and the
  // leaderboards so a to-do can never be mistaken for a habit.
  kind String @default("daily")

  // Only meaningful for kind "once": the day it's meant to happen, as a calendar
  // date in the owner's timezone.
  dueDate DateTime? @db.Date

  // Set when this task is one member's copy of a group challenge. Detaching it
  // (leaving the group, or the challenge being removed) keeps the task and its
  // history as an ordinary personal task rather than deleting someone's streak.
  groupTaskId String?

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupTask   GroupTask?       @relation(fields: [groupTaskId], references: [id], onDelete: SetNull)
  completions TaskCompletion[]

  @@index([userId])
  @@index([groupTaskId])
}

model TaskCompletion {
  id        String   @id @default(cuid())
  taskId    String
  localDate DateTime @db.Date
  createdAt DateTime @default(now())

  // "manual" when you ticked it, "synced" when the platform confirmed it. A sync
  // never overwrites a manual day, so your own record is always the one that wins.
  source String @default("manual")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, localDate])
}

// The detail behind a verified day: which problems a platform says you actually
// solved, so a green tile can answer "doing what?". Written by sync and additive
// like the rest of it — nothing here is ever revoked.
//
// It has to be stored rather than fetched on demand because LeetCode caps its
// recent-submissions list at 20 regardless of what you ask for; sync accumulates
// history that the live endpoint has already forgotten.
model PlatformActivity {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  localDate DateTime @db.Date
  title     String
  url       String?

  // The platform's own key for the thing done — LeetCode's title slug. Re-syncing a
  // day can't duplicate a row, and solving the same problem twice counts once.
  externalId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, localDate, externalId])
  @@index([userId, platform, localDate])
}
